{
  "name": "@neo-quiz/windows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && electron dist-electron/main.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "build:electron": "node electron/construire.mjs",
    "build": "npm run typecheck && npm run typecheck:electron && npm run build:electron && vite build",
    "pack:win": "npm run build && electron-builder --win nsis --config electron-builder.config.mjs",
    "pack:linux": "npm run build && electron-builder --linux AppImage --config electron-builder.config.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "lucide": "^1.41.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.19",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
