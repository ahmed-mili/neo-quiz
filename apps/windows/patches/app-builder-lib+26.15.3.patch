+# Neo Quiz: extract straight into $INSTDIR. The stock `extractEmbeddedAppPackage`
+# decompresses into a staging folder, then COPIES everything into $INSTDIR: that
+# copy exists for replacing an installed application whose files may be in use.
+# $INSTDIR is a fresh temporary folder here, so the copy only doubled the bytes
+# written to disk (measured: 312 MB extracted, then 312 MB copied again).
+!macro extractEmbeddedAppPackageDirectly
+  !ifdef COMPRESS
+    SetCompress off
+  !endif
+
+  Var /GLOBAL packageArch
+
+  !insertmacro identify_package
+  !insertmacro compute_files_for_current_arch
+
+  !ifdef COMPRESS
+    SetCompress "${COMPRESS}"
+  !endif
+
+  !ifdef ZIP_COMPRESSION
+    nsisunz::Unzip "$PLUGINSDIR\app-$packageArch.zip" "$INSTDIR"
+    Pop $R0
+    StrCmp $R0 "success" +3
+      MessageBox MB_OK|MB_ICONEXCLAMATION "$(decompressionFailed)$\n$R0"
+      Quit
+  !else
+    Nsis7z::Extract "$PLUGINSDIR\app-$packageArch.7z"
+  !endif
+  Delete "$PLUGINSDIR\app-$packageArch.${COMPRESSION_METHOD}"
+  !insertmacro custom_files_post_decompression
+!macroend
+
 Section
   !ifdef SPLASH_IMAGE
     HideWindow
   !endif
 
+  # Neo Quiz: one status line in the user's language, instead of NSIS's own
+  # running commentary naming the temporary folder and the archive.
+  SetDetailsPrint textonly
+  DetailPrint "$(installing)"
+  SetDetailsPrint none
+
   StrCpy $INSTDIR "$PLUGINSDIR\app"
   !ifdef UNPACK_DIR_NAME
     StrCpy $INSTDIR "$TEMP\${UNPACK_DIR_NAME}"
@@ -70,7 +126,7 @@ Section
     !ifdef APP_DIR_32
       File /r "${APP_DIR_32}\*.*"
     !else
-      !insertmacro extractEmbeddedAppPackage
+      !insertmacro extractEmbeddedAppPackageDirectly
     !endif
   !endif
 
