{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Neo Quiz",
    "version": "0.0.0",
    "identifier": "com.ahmed.neoquiz",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1421",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Neo Quiz",
                "width": 1280,
                "height": 840,
                "minWidth": 900,
                "minHeight": 600
            }
        ],
        "security": { "csp": null }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "publisher": "Ahmed",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
