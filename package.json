{
  "name": "neo-quiz",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "release": "cmd /c call scripts\\release.bat",
    "app:dev": "npm --prefix apps/windows run tauri -- dev",
    "app:build": "npm --prefix apps/windows run tauri -- build",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "check:app": "npm --prefix apps/windows run build",
    "check:md": "node scripts/check-markdown.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:quiz-io": "node scripts/check-quiz-io.mjs",
    "check:lesson": "node scripts/check-lesson.mjs",
    "check:markers": "node scripts/check-render-markers.mjs \"C:/obsidian-vaults/Personal\" \"C:/obsidian-vaults/Efrei\"",
    "check:scanner": "node scripts/check-scanner.mjs",
    "check:scheduler": "node scripts/check-scheduler.mjs",
    "check:host": "node scripts/check-host.mjs",
    "check:dashboard-dom": "node scripts/check-dashboard-dom.mjs",
    "check:folders": "node scripts/check-folders.mjs",
    "check:windows-host": "node scripts/check-windows-host.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:obsidian-host": "node scripts/check-obsidian-host.mjs",
    "check:math-render": "node scripts/check-math-render.mjs",
    "check:review-store": "node scripts/check-review-store.mjs",
    "check:review-log": "node scripts/check-review-log.mjs",
    "check:module-edit": "node scripts/check-module-edit.mjs",
    "check:rename-match": "node scripts/check-rename-match.mjs",
    "report:multiblock": "node scripts/report-multiblock.mjs \"C:/obsidian-vaults/Personal\" \"C:/obsidian-vaults/Efrei\"",
    "check:engine-review": "node scripts/check-engine-review.mjs",
    "check:electron-fs": "node scripts/check-electron-fs.mjs",
    "check:electron-index": "node scripts/check-electron-index.mjs",
    "test": "node --test scripts/set-version.test.mjs scripts/ship.test.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:patch": "node scripts/set-version.mjs patch",
    "version:minor": "node scripts/set-version.mjs minor",
    "version:major": "node scripts/set-version.mjs major"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "mathlive": "^0.110.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
