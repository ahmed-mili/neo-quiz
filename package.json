{
  "name": "quiz-blocks",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "release": "cmd /c call scripts\\release.bat",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "check:md": "node scripts/check-markdown.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:lesson": "node scripts/check-lesson.mjs",
    "check:markers": "node scripts/check-render-markers.mjs \"C:/obsidian-vaults/Personal\" \"C:/obsidian-vaults/Efrei\"",
    "test": "node --test scripts/set-version.test.mjs scripts/ship.test.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:patch": "node scripts/set-version.mjs patch",
    "version:minor": "node scripts/set-version.mjs minor",
    "version:major": "node scripts/set-version.mjs major"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "mathlive": "^0.110.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  }
}
